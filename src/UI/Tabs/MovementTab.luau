--!nonstrict
return function(services: any, tab: any): any
    local load = services:Get("Require")
    local section = load("src/UI/Components/Section.luau", services)
    local toggle = load("src/UI/Components/Toggle.luau", services)
    local slider = load("src/UI/Components/Slider.luau", services)
    local dropdown = load("src/UI/Components/Dropdown.luau", services)
    local keybind = load("src/UI/Components/Keybind.luau", services)
    local textbox = load("src/UI/Components/Textbox.luau", services)
    local movement = services:Get("LocomotionService")
    local scope = services:Get("Disposer"):CreateChild("Movement tab")
    local humanoid = section:Create(tab.LeftCol, "Character overrides")
    section:Info(humanoid, "Zero means leave the game's value alone. JumpPower and JumpHeight follow the game's UseJumpPower mode.")
    slider(humanoid, "Walk speed", "Movement.Speed", 0, 200, 1, "", nil, 1)
    slider(humanoid, "Jump power", "Movement.JumpPower", 0, 200, 1, "", nil, 1)
    slider(humanoid, "Jump height", "Movement.JumpHeight", 0, 100, 0.5, " studs", nil, 1)
    toggle(humanoid, "Shift to sprint", "Movement.SprintEnabled", nil, 1)
    slider(humanoid, "Sprint speed", "Movement.SprintSpeed", 1, 200, 1, "", nil, 1)
    toggle(humanoid, "Infinite air jump", "Movement.InfJump", nil, 1)
    local step = section:Create(tab.LeftCol, "Displacement & world")
    toggle(step, "CFrame speed", "Movement.CFrameSpeed", nil, 1)
    slider(step, "Extra displacement speed", "Movement.CFrameSpeedValue", 0, 200, 1, " studs/s", nil, 1)
    slider(step, "World gravity · 0 restores", "Movement.WorldGravity", 0, 400, 1, "", nil, 1)
    slider(step, "Camera FOV · 0 restores", "Camera.FOV", 0, 120, 1, "°", nil, 1)
    local flight = section:Create(tab.RightCol, "Flight")
    toggle(flight, "Enable flight", "Movement.FlyEnabled", nil, 1)
    slider(flight, "Flight speed", "Movement.FlySpeed", 1, 300, 1, " studs/s", nil, 1)
    keybind(flight, "Flight hotkey", "Settings.Binds.Fly", nil, 0)
    toggle(flight, "Mobile: ascend", "Movement.MobileFlyUp", nil, 1)
    toggle(flight, "Mobile: descend", "Movement.MobileFlyDown", nil, 1)
    section:Info(flight, if services:Get("Environment"):IsMobile() then "Use the movement thumbstick and the ascend/descend toggles. Flight re-engages after a respawn."
        else "WASD follows the camera. Space ascends; Shift descends. Flight pauses while typing.")
    local travel = section:Create(tab.RightCol, "Position bookmarks")
    local name = textbox(travel, "Bookmark name", "Home")
    local selected = dropdown(travel, "Saved position", nil, movement:ListBookmarks())
    textbox:CreateButton(travel, "Save current position", function() return movement:SaveBookmark(name.Box.Text) end, 1)
    textbox:CreateButton(travel, "Go to bookmark", function() return movement:GoToBookmark(selected:Get() or "") end, 1)
    textbox:CreateButton(travel, "Delete bookmark", function() return movement:DeleteBookmark(selected:Get() or "") end, 1)
    scope:Add(services:Get("EventBus"):Subscribe("BookmarksChanged", function() selected:Refresh(movement:ListBookmarks(), true) end))
    section:Info(travel, "Bookmarks are session-only. Teleports clear assembly velocity and temporarily suppress anti-fling.")
    local mouse = section:Create(tab.RightCol, "Click teleport")
    toggle(mouse, "Enable click / tap teleport", "Settings.TpToMouse", nil, 1)
    section:Info(mouse, if services:Get("Environment"):IsMobile() then "Tap a world surface, outside the menu, to teleport." else "Hold Ctrl and left-click a world surface. UI clicks and focused textboxes are ignored.")
    return { Name = tab.Name }
end
