--!nonstrict
return function(services: any, tab: any): any
    local load = services:Get("Require")
    local section = load("src/UI/Components/Section.luau", services)
    local textbox = load("src/UI/Components/Textbox.luau", services)
    local dropdown = load("src/UI/Components/Dropdown.luau", services)
    local tracker, movement, state = services:Get("PlayerTracker"), services:Get("LocomotionService"), services:Get("StateStore")
    local scope = services:Get("Disposer"):CreateChild("Players tab")
    local select = section:Create(tab.LeftCol, "Player directory")
    local query = textbox(select, "Filter players", "")
    local target = dropdown(select, "Selected player", nil, tracker:GetPlayerNames(true))
    local function refresh() target:Refresh(tracker:GetPlayerNames(true, query.Box.Text), true) end
    scope:Connect(query.Box:GetPropertyChangedSignal("Text"), refresh)
    scope:Add(services:Get("EventBus"):Subscribe("PlayerJoined", refresh))
    scope:Add(services:Get("EventBus"):Subscribe("PlayerLeft", refresh))
    section:Info(select, "Username and display-name filtering is case-insensitive. Exact names are resolved before partial names.")
    local actions = section:Create(tab.LeftCol, "Player actions")
    textbox:CreateButton(actions, "Teleport to player", function() return movement:TeleportToPlayer(tracker:GetPlayerByName(target:Get() or "")) end, 1)
    textbox:CreateButton(actions, "Spectate player", function() return tracker:StartSpectate(tracker:GetPlayerByName(target:Get() or "")) end, 1)
    textbox:CreateButton(actions, "Stop spectating", function() tracker:StopSpectate(); return true, "Camera subject restored" end, 0)
    textbox:CreateButton(actions, "Copy username", function() return tracker:CopyName(tracker:GetPlayerByName(target:Get() or "")) end, 1)
    local whitelist = section:Create(tab.RightCol, "Target whitelist")
    local summary = section:Info(whitelist, tracker:GetWhitelistSummary())
    scope:Add(state:Observe("Settings.Whitelist", function() summary:Set(tracker:GetWhitelistSummary()) end))
    textbox:CreateButton(whitelist, "Whitelist selected player", function() return tracker:AddWhitelist(tracker:GetPlayerByName(target:Get() or "")) end, 1)
    textbox:CreateButton(whitelist, "Remove selected from whitelist", function() return tracker:RemoveWhitelist(tracker:GetPlayerByName(target:Get() or "")) end, 1)
    textbox:CreateButton(whitelist, "Clear whitelist", function() state:Set("Settings.Whitelist", {}); return true, "Whitelist cleared" end, 1)
    section:Info(whitelist, "Aimbot and triggerbot each decide independently whether to honor this shared whitelist.")
    local fling = section:Create(tab.RightCol, "Fling attack · Full")
    section:Info(fling, "A two-second, client-side physics attempt. Stop flight first. Server authority may prevent it from affecting the target.")
    textbox:CreateButton(fling, "Fling selected player", function() return movement:FlingPlayer(tracker:GetPlayerByName(target:Get() or "")) end, 3)
    textbox:CreateButton(fling, "Stop fling & restore position", function() movement:StopFling(); return true, "Fling stopped" end, 0)
    return { Name = tab.Name }
end
